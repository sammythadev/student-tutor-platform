NEXT_PUBLIC_API_URL=/api/backend
BACKEND_URL=http://localhost:4000

# ─── Logging ───────────────────────────────────────────────────────────────
# Levels are cumulative: 'warn' means error + warn.
# One of error | warn | info | debug.
# Default: error+warn in production, all four in development.
LOG_LEVEL=warn

# Browser-only level. Read by the client bundle at build time, so it must be
# prefixed NEXT_PUBLIC_ and is inlined — do not put anything sensitive here.
# Defaults to the same behaviour as LOG_LEVEL.
NEXT_PUBLIC_LOG_LEVEL=debug

# Master kill switch. Set to false to silence the logger entirely.
LOG_ENABLED=true

# Server-side JSONL log file. Node runtime only (proxy, Server Components,
# route handlers) — the browser sandbox cannot write files and ignores this.
# Directories are created on first write. Omit or leave blank for console only.
LOG_FILE_PATH=logs/frontend.log
