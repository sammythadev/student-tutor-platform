{
  "compilerOptions": {
    // module "preserve" + bundler resolution keep CJS emission for the ts-node
    // CLI scripts and ts-jest tests (this package has no "type": "module")
    // while dropping node10 resolution, which TypeScript 6 deprecates and the
    // native TypeScript 7 compiler rejects outright. Path aliases are relative
    // to this file, so baseUrl (also removed) is not needed.
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@common/*": ["./src/common/*"],
      "@config": ["./src/configs/index.ts"],
      "@configs/*": ["./src/configs/*"],
      "@database": ["./src/database/index.ts"],
      "@database/*": ["./src/database/*"],
      "@modules/*": ["./src/modules/*"],
      "@types/*": ["./src/types/*"],
      "@core/*": ["./src/core/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "forceConsistentCasingInFileNames": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    // TypeScript 6 stopped auto-including every @types package and requires an
    // explicit rootDir: ambient globals (process/node, describe/it/expect/jest)
    // only resolve when listed in `types`.
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "exclude": [
    "src/core/evaluation/tui",
    "scripts/render-probe.tsx",
    "scripts/render-probe-baselines.tsx",
    "scripts/render-probe-gap.tsx",
    "scripts/render-probe-help.tsx"
  ]
}
